<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net471</TargetFramework>
    <RootNamespace>PLATE.Client</RootNamespace>
    <AssemblyName>PLATE.Client</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DisableImplicitFrameworkReferences>false</DisableImplicitFrameworkReferences>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference assemblies for building against net471 without an installed targeting pack -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- the patch integrity tests drive the internal patch classes directly -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PLATE.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!--
      The ballistic limit is compiled into both halves from one file rather than written
      twice. The wound channel is duplicated (WoundModel / ClientWoundModel) with a
      comment asking the next person to keep them in step, and that is a bad trade at
      this size: the server bakes the card numbers from it and the client decides real
      hits with it, and the two silently disagreeing would be invisible in a raid.
      Pure System.Math, so it compiles under net471 as happily as under net9.
    -->
    <Compile Include="..\..\server\PLATE.Server\Services\BallisticLimit.cs"
             Link="Ballistics\BallisticLimit.cs" />
    <Compile Include="..\..\server\PLATE.Server\Services\YawModel.cs"
             Link="Ballistics\YawModel.cs" />
  </ItemGroup>

  <!-- All game assemblies are referenced by HintPath from the install and not copied to the output -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(SptGameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
